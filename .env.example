# Founder Cockpit — environment variables.
# Copy to .env.local for local overrides. NEVER commit real values.

# --- Database -------------------------------------------------------------
# Empty  -> embedded PGlite database in ./.data/pglite (zero setup, local only).
# Set    -> real Postgres, e.g. Supabase "Connection string" (Transaction pooler, port 6543).
DATABASE_URL=
# Production (npm start / Vercel) REFUSES to start without DATABASE_URL. Only for a local
# production test on the embedded database (e2e does this): ALLOW_LOCAL_DB=1. Never on Vercel.
ALLOW_LOCAL_DB=

# Vercel builds run `npm run vercel-build` (vercel.json):
#   db:migrate:deploy -> applies migrations ONLY when MIGRATE_ON_BUILD=1 (and DATABASE_URL set)
#   db:seed:deploy    -> seeds ONLY when SEED_ON_BUILD=1, DATABASE_URL is set and the database
#                        has no founders yet (first deploy); same guards as db:seed
#   next build        -> never touches the database
MIGRATE_ON_BUILD=
SEED_ON_BUILD=
# Optional: a separate URL for migrations only (e.g. Supabase "Session pooler", port 5432 on
# the pooler host). Empty -> migrations use DATABASE_URL (the Transaction pooler works too).
MIGRATION_DATABASE_URL=

# --- Auth -----------------------------------------------------------------
# local    -> email + password stored in our own users table (works now).
# supabase -> Supabase Auth (stub, not implemented yet).
AUTH_MODE=local
# Long random string used to sign session cookies. REQUIRED in production.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=
# Password given to both founders when `npm run db:seed` creates them.
# Empty -> local embedded DB only: the dev password "founders-dev-2026".
# A real Postgres/Supabase DB REQUIRES a private password of 12+ characters here
# (the seed refuses the dev default). Existing founders keep their password unless
# SEED_RESET_PASSWORDS=1 (which also signs them out everywhere).
DEV_FOUNDER_PASSWORD=
SEED_RESET_PASSWORDS=
# "[sample]" tasks: on by default for the local embedded DB (0 = off),
# off by default on Postgres (1 = on).
SEED_SAMPLES=

# --- Time -----------------------------------------------------------------
# Business timezone used for "today" and overdue rules (GMT+6).
APP_TIMEZONE=Asia/Bishkek

# --- Supabase (later) -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram -------------------------------------------------------------
# From @BotFather. Empty -> nothing is sent to Telegram; messages go to the dev inbox
# (/dev/notifications). Server-only, never expose it.
TELEGRAM_BOT_TOKEN=
# Random text you choose (letters, digits, _ and - only, 1-256 chars). Telegram sends it
# back in X-Telegram-Bot-Api-Secret-Token; the webhook rejects anything else.
# Generate one with:  openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# The bot's @username without "@" (shown on Settings; used in "Invite to Telegram" links
# https://t.me/<bot>?start=CODE). Empty: founders_app_bot (the founders' bot).
TELEGRAM_BOT_USERNAME=

# --- Scheduler ------------------------------------------------------------
# Protects /api/cron/tick (plan + send notifications). Empty -> the endpoint always says 401.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=
# The site's address, e.g. https://<your-app>.vercel.app: links in Telegram messages, the
# webhook that Settings → "Connect Telegram" sets, the URL "Start reminder clock" calls.
# Empty on Vercel -> Vercel's production address (VERCEL_PROJECT_PRODUCTION_URL) is used.
# Scripts (`npm run cron:tick`, `npm run telegram:poll`) default to http://localhost:3000.
APP_URL=

# --- Claude connector (OAuth) ---------------------------------------------------
# Extra hosts (comma-separated, exact, https only) a registered OAuth client may redirect to.
# Always allowed: claude.ai, claude.com, localhost / 127.0.0.1. Usually empty.
OAUTH_EXTRA_REDIRECT_HOSTS=

# --- Developer tools --------------------------------------------------------
# /dev/notifications is on in development. In a production build it is on only with
# DEV_TOOLS=1 (e.g. preview deployments, e2e). NEVER set this on the real production site.
DEV_TOOLS=

# --- Data sources (connectors, src/server/connectors) -------------------------
# All empty for now: the connectors are placeholders that make no network calls and
# show "not configured" on Settings → Data sources. Fill these in Vercel only once the
# API access exists and the connector code is written. Server-only, never expose them.
# Kiwi Go app (from Edil / Jobutify)
KIWIGO_API_URL=
KIWIGO_API_TOKEN=
# WMS, wms.jobutify.com (from Edil / Jobutify)
WMS_API_URL=
WMS_API_TOKEN=
# Alura Style ERP (from Edil / Jobutify)
ALURA_ERP_API_URL=
ALURA_ERP_API_TOKEN=
# Wildberries seller API token (WB seller portal → Settings → API access, read-only)
WB_API_TOKEN=

# --- Holding (акты, договоры, documents) ------------------------------------
# Days into the next month before a month's акт is expected (default 10: October is
# expected from 11 November, and the "ask Elmurat" item is planned on the 11th).
HOLDING_ACTS_GRACE_DAYS=
# Where uploaded documents are stored. Empty = .data/uploads in development; in PRODUCTION
# uploads are OFF ("File uploads arrive with Supabase storage", API 503) unless:
#   local    = .data/uploads on a server with a lasting disk (never on Vercel, ignored there)
#   supabase = placeholder adapter, still off until a developer writes it
FILE_STORAGE=

# --- AI provider (AI roles) --------------------------------------------------
# NOT CHOSEN YET — the founders decide. Only "none" is implemented: the AI roles still run
# (rule-based analysis, data requests, reports); the AI summary is skipped. Leave empty.
# When a provider is chosen, a developer adds it in src/server/ai/provider.ts and its own
# key variable is set in the hosting dashboard (never in the repo).
AI_PROVIDER=

# --- Browser extension (POST /api/v1/ingest) -----------------------------------
# Optional. Comma-separated Chrome extension IDs allowed to call the ingest API from the
# browser (CORS), e.g. EXTENSION_ALLOWED_IDS=abcdefghijklmnopabcdefghijklmnop. Empty = any
# chrome-extension:// origin (fine for development). Set it in production once the founders'
# extension has its ID (chrome://extensions → the extension → ID).
EXTENSION_ALLOWED_IDS=
